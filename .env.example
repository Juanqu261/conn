# Local development settings for Conn.
#
# Copy this file to .env, which Git ignores, fill in the two GitHub OAuth
# values below, and run pnpm dev. Every other value is a development default,
# not a secret.
#
# Development builds of conn (go run ./cmd/conn, or a local go build) and
# pnpm db:migrate read .env from the current directory automatically:
#
#   - only CONN_ keys are read, so other projects' .env files stay private;
#   - variables already set in your shell win over this file;
#   - empty values are skipped;
#   - CONN_TOKEN is always ignored.
#
# Release builds never read .env. Docker Compose reads it on its own, so
# CONN_DEV_DB_PORT also applies to pnpm db:start. Run conn doctor to see
# what was loaded.
# --- conn server ------------------------------------------------------------

# PostgreSQL connection for conn server. These credentials match compose.yaml.
# If you change CONN_DEV_DB_PORT, change the port here too.
CONN_DATABASE_URL=postgres://conn:conn-development-only@127.0.0.1:55432/conn?sslmode=disable

# --- GitHub OAuth app: the two values you must fill in -----------------------
#
# Create or open your OAuth app at GitHub > Settings > Developer settings >
# OAuth Apps, then:
#   - tick "Enable Device Flow" (conn login uses it);
#   - set "Authorization callback URL" to exactly
#       http://127.0.0.1:5173/v1/auth/github/web/callback
#     which is where pnpm dev serves Conn Lab;
#   - copy the Client ID below, and generate a client secret for it.
#
# The client secret IS a secret: keep it only here in .env, which Git
# ignores. Then run pnpm dev.
CONN_GITHUB_CLIENT_ID=
CONN_GITHUB_CLIENT_SECRET=

# Only when you run conn server on its own instead of pnpm dev: the origin
# people open Conn Lab at. pnpm dev sets it to http://127.0.0.1:5173. The
# OAuth callback URL must then be <this origin>/v1/auth/github/web/callback.
# CONN_PUBLIC_URL=http://127.0.0.1:8080

# --- conn CLI ---------------------------------------------------------------

# Server used by login, logout, whoami, and doctor. This is the default, so
# the line is optional. Plain http is accepted only for loopback addresses.
CONN_SERVER_URL=http://127.0.0.1:8080

# --- Development database and tests ----------------------------------------

# Host port of the Docker Compose database. Used by pnpm db:start,
# pnpm db:migrate, and the PostgreSQL tests.
CONN_DEV_DB_PORT=55432

# Optional server for PostgreSQL tests. Leave unset to use the Compose
# database whenever it is running.
# CONN_TEST_DATABASE_URL=postgres://conn:conn-development-only@127.0.0.1:55432/conn?sslmode=disable

# --- Do not set here --------------------------------------------------------

# CONN_TOKEN is a real session credential. It overrides the session stored by
# conn login and is never saved by Conn. Set it only in a single shell or CI
# job when no credential store is available; never write it to a file.
