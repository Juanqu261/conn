{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:conn:schema:v1:ci-credential-list",
  "title": "CI credential list",
  "description": "The CI credentials of one Project, newest first, as shown to its owner. Tokens are never listed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id", "credentials"],
  "properties": {
    "project_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
    "credentials": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "urn:conn:schema:v1:ci-credential" }
    }
  }
}
