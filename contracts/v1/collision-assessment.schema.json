{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:conn:schema:v1:collision-assessment",
  "title": "CollisionAssessment",
  "description": "An advisory, explainable semantic interaction between two exact active Intent revisions. Human decisions set the state: false_positive dismisses; dependency, sequencing, contract_agreement, and accepted_risk resolve; other kinds put it under review.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "collision_id",
    "project_id",
    "left_intent_id",
    "left_intent_revision",
    "right_intent_id",
    "right_intent_revision",
    "rule_id",
    "severity",
    "confidence",
    "state",
    "matching_claim_refs",
    "matched_subjects",
    "explanation_markdown",
    "created_at"
  ],
  "properties": {
    "collision_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
    "project_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
    "left_intent_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
    "left_intent_revision": { "$ref": "urn:conn:schema:v1:common#/$defs/revision" },
    "right_intent_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
    "right_intent_revision": { "$ref": "urn:conn:schema:v1:common#/$defs/revision" },
    "rule_id": {
      "enum": [
        "shared_declared_invariant",
        "shared_exported_symbol",
        "contract_producer_consumer",
        "schema_resource_overlap"
      ]
    },
    "severity": { "$ref": "urn:conn:schema:v1:common#/$defs/collisionSeverity" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "state": { "enum": ["open", "under_review", "resolved", "dismissed", "stale"] },
    "matching_claim_refs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 20,
      "items": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" }
    },
    "matched_subjects": {
      "description": "Sorted normalized subjects that matched the rule. A list at the 50-item bound may be truncated.",
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": { "$ref": "urn:conn:schema:v1:common#/$defs/semanticSubject" }
    },
    "decision_ref": {
      "description": "The human decision that set or was inherited by this assessment's state.",
      "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7"
    },
    "supporting_context_refs": {
      "type": "array",
      "maxItems": 50,
      "items": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" }
    },
    "latest_combination_outcome": {
      "description": "Read views only: the outcome of the most recent combination check of this collision. Stored assessments never carry it.",
      "enum": ["passing", "failing", "merge_conflict", "incomplete"]
    },
    "explanation_markdown": { "$ref": "urn:conn:schema:v1:common#/$defs/markdown" },
    "created_at": { "$ref": "urn:conn:schema:v1:common#/$defs/timestamp" },
    "superseded_at": { "$ref": "urn:conn:schema:v1:common#/$defs/timestamp" }
  }
}
