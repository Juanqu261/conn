{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:conn:schema:v1:objective",
  "title": "Objective revision",
  "description": "One immutable revision of a narrative Objective with optional keyed points. Key uniqueness is enforced by application validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "objective_id",
    "project_id",
    "revision",
    "title",
    "overview_markdown",
    "accountable_human_id",
    "created_at"
  ],
  "properties": {
    "objective_id": {
      "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7"
    },
    "project_id": {
      "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7"
    },
    "revision": {
      "$ref": "urn:conn:schema:v1:common#/$defs/revision"
    },
    "key": {
      "$ref": "urn:conn:schema:v1:common#/$defs/key"
    },
    "title": {
      "$ref": "urn:conn:schema:v1:common#/$defs/title"
    },
    "overview_markdown": {
      "$ref": "urn:conn:schema:v1:common#/$defs/markdown"
    },
    "accountable_human_id": {
      "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7"
    },
    "source_refs": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/sourceRef"
      }
    },
    "import_provenance": {
      "$ref": "#/$defs/importProvenance"
    },
    "key_points": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/keyPoint"
      }
    },
    "created_at": {
      "$ref": "urn:conn:schema:v1:common#/$defs/timestamp"
    }
  },
  "$defs": {
    "sourceRef": {
      "description": "Optional external context. It never replaces the captured overview.",
      "type": "object",
      "additionalProperties": false,
      "required": ["uri"],
      "properties": {
        "uri": {
          "$ref": "urn:conn:schema:v1:common#/$defs/httpUri"
        },
        "title": {
          "$ref": "urn:conn:schema:v1:common#/$defs/title"
        }
      }
    },
    "sourceKind": {
      "description": "The method an imported Objective came from: a Kiro spec, a Spec Kit feature, or a GitHub issue.",
      "enum": ["kiro_spec", "speckit_feature", "github_issue"]
    },
    "importProvenance": {
      "description": "Immutable captured provenance for a human-authorized import of a local Kiro specification, a local Spec Kit feature, or a GitHub issue. The source is never live-synchronized.",
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "source_ref", "content_hash", "imported_at"],
      "properties": {
        "source_kind": { "$ref": "#/$defs/sourceKind" },
        "source_ref": { "$ref": "urn:conn:schema:v1:common#/$defs/relativePath" },
        "source_revision_ref": { "$ref": "urn:conn:schema:v1:common#/$defs/opaqueReference" },
        "content_hash": { "$ref": "urn:conn:schema:v1:common#/$defs/sha256" },
        "imported_at": { "$ref": "urn:conn:schema:v1:common#/$defs/timestamp" }
      }
    },
    "keyPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "kind", "statement"],
      "properties": {
        "key": {
          "$ref": "urn:conn:schema:v1:common#/$defs/key"
        },
        "kind": {
          "enum": ["outcome", "acceptance_criterion", "invariant", "constraint", "question"]
        },
        "statement": {
          "$ref": "urn:conn:schema:v1:common#/$defs/statement"
        }
      }
    }
  }
}
