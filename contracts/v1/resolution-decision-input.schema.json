{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:conn:schema:v1:resolution-decision-input",
  "title": "ResolutionDecisionInput",
  "description": "Human-authored content for an immutable resolution decision. Conn derives the deciding human from the authenticated session. The optional expected revisions and state are one precondition: when present, the backend decides only if the collision still names exactly those Intent revisions and is still in that state, and otherwise changes nothing.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "binding", "rationale_markdown"],
  "properties": {
    "selected_proposal_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
    "kind": { "$ref": "urn:conn:schema:v1:common#/$defs/resolutionKind" },
    "binding": { "type": "boolean" },
    "rationale_markdown": { "$ref": "urn:conn:schema:v1:common#/$defs/rationale" },
    "references": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "urn:conn:schema:v1:common#/$defs/opaqueReference" }
    },
    "expected_left_intent_revision": {
      "description": "The left Intent revision the deciding human reviewed.",
      "$ref": "urn:conn:schema:v1:common#/$defs/revision"
    },
    "expected_right_intent_revision": {
      "description": "The right Intent revision the deciding human reviewed.",
      "$ref": "urn:conn:schema:v1:common#/$defs/revision"
    },
    "expected_state": {
      "description": "The collision state the deciding human reviewed.",
      "enum": ["open", "under_review", "resolved", "dismissed", "stale"]
    }
  },
  "dependentRequired": {
    "expected_left_intent_revision": ["expected_right_intent_revision", "expected_state"],
    "expected_right_intent_revision": ["expected_left_intent_revision", "expected_state"],
    "expected_state": ["expected_left_intent_revision", "expected_right_intent_revision"]
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "enum": ["contract_agreement", "accepted_risk", "revise_objective", "revise_blueprint"]
          }
        },
        "required": ["kind"]
      },
      "then": { "properties": { "binding": { "const": true } } }
    }
  ]
}
