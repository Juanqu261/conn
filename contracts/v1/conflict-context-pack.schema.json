{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:conn:schema:v1:conflict-context-pack",
  "title": "ConflictContextPack",
  "description": "A bounded, portable factual context for discussing one semantic collision in a human-selected agent session or meeting.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "collision",
    "objective",
    "intents",
    "claims",
    "uncertainties",
    "allowed_resolution_kinds",
    "safe_handling_note"
  ],
  "properties": {
    "collision": { "$ref": "urn:conn:schema:v1:collision-assessment" },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective_id", "revision", "title"],
      "properties": {
        "objective_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
        "revision": { "$ref": "urn:conn:schema:v1:common#/$defs/revision" },
        "title": { "$ref": "urn:conn:schema:v1:common#/$defs/title" },
        "charter_refs": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" }
        }
      }
    },
    "intents": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "urn:conn:schema:v1:intent-revision" }
    },
    "claims": {
      "type": "array",
      "minItems": 2,
      "maxItems": 40,
      "items": { "$ref": "urn:conn:schema:v1:semantic-claim" }
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 50,
      "items": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" }
    },
    "uncertainties": {
      "type": "array",
      "maxItems": 50,
      "items": { "$ref": "urn:conn:schema:v1:common#/$defs/statement" }
    },
    "existing_decision_refs": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" }
    },
    "combination_checks": {
      "description": "The five most recent combination checks of this collision, newest first. They are advisory and never change the collision state.",
      "type": "array",
      "maxItems": 5,
      "items": { "$ref": "urn:conn:schema:v1:combination-check" }
    },
    "unresolved_question": { "$ref": "urn:conn:schema:v1:common#/$defs/statement" },
    "allowed_resolution_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "urn:conn:schema:v1:common#/$defs/resolutionKind" }
    },
    "safe_handling_note": { "$ref": "urn:conn:schema:v1:common#/$defs/statement" }
  }
}
