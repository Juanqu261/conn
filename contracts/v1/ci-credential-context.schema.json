{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:conn:schema:v1:ci-credential-context",
  "title": "CI credential context",
  "description": "What a CI credential may read: one Project and one RepositoryConnection, until it expires.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "credential_id",
    "project_id",
    "project_name",
    "repository_id",
    "canonical_remote",
    "expires_at"
  ],
  "properties": {
    "credential_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
    "project_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
    "project_name": { "$ref": "urn:conn:schema:v1:common#/$defs/title" },
    "repository_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
    "canonical_remote": { "$ref": "urn:conn:schema:v1:common#/$defs/repositoryRemote" },
    "default_branch": { "$ref": "urn:conn:schema:v1:common#/$defs/opaqueReference" },
    "expires_at": { "$ref": "urn:conn:schema:v1:common#/$defs/timestamp" }
  }
}
