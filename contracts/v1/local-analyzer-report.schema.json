{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:conn:schema:v1:local-analyzer-report",
  "title": "Local analyzer report",
  "description": "Bounded local analysis output. It contains normalized claims and diagnostics, never repository source, diffs, or prompts. Planned mode describes files a participant intends to change; observed mode describes the difference between the Intent base revision and the working tree; diagnostics mode counts compiler diagnostic codes per path for pair verification, has no claims, and is never attached to an Intent.",
  "type": "object",
  "additionalProperties": false,
  "required": ["report_version", "mode", "repository", "claims", "diagnostics"],
  "properties": {
    "report_version": { "const": 2 },
    "mode": { "enum": ["planned", "observed", "diagnostics"] },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_remote"],
      "properties": {
        "canonical_remote": { "$ref": "urn:conn:schema:v1:common#/$defs/repositoryRemote" },
        "base_revision_ref": { "$ref": "urn:conn:schema:v1:common#/$defs/gitCommit" },
        "head_revision_ref": { "$ref": "urn:conn:schema:v1:common#/$defs/gitCommit" },
        "branch_ref": { "$ref": "urn:conn:schema:v1:common#/$defs/opaqueReference" }
      }
    },
    "claims": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "allOf": [
          { "$ref": "urn:conn:schema:v1:semantic-claim-candidate" },
          {
            "type": "object",
            "properties": { "provenance_kind": { "const": "static_analysis" } },
            "required": ["provenance_kind"]
          }
        ]
      }
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "$ref": "urn:conn:schema:v1:common#/$defs/opaqueReference" },
          "message": { "$ref": "urn:conn:schema:v1:common#/$defs/statement" },
          "path": { "$ref": "urn:conn:schema:v1:common#/$defs/relativePath" },
          "line": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "diagnostic_counts": {
      "description": "Diagnostics mode only: compiler diagnostic codes aggregated over every discovered program. Message text is never included.",
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "count"],
        "properties": {
          "code": { "$ref": "urn:conn:schema:v1:common#/$defs/opaqueReference" },
          "path": { "$ref": "urn:conn:schema:v1:common#/$defs/relativePath" },
          "count": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "diagnostic_counts_truncated": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "mode": { "const": "diagnostics" } },
        "required": ["mode"]
      },
      "then": {
        "required": ["diagnostic_counts", "diagnostic_counts_truncated"],
        "properties": {
          "claims": { "type": "array", "maxItems": 0 },
          "diagnostic_counts": { "type": "array" },
          "diagnostic_counts_truncated": { "type": "boolean" }
        }
      },
      "else": {
        "properties": {
          "diagnostic_counts": false,
          "diagnostic_counts_truncated": false
        }
      }
    }
  ]
}
