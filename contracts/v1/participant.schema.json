{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:conn:schema:v1:participant",
  "title": "Participant",
  "description": "A bounded operating identity under one authenticated Conn Human. It is attribution, not independent authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["participant_id", "project_id", "human_id", "adapter_kind", "created_at"],
  "properties": {
    "participant_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
    "project_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
    "human_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
    "adapter_kind": { "enum": ["kiro", "mcp", "cli", "ci", "github", "other_registered_adapter"] },
    "local_session_ref": { "$ref": "urn:conn:schema:v1:common#/$defs/opaqueReference" },
    "display_label": { "$ref": "urn:conn:schema:v1:common#/$defs/title" },
    "created_at": { "$ref": "urn:conn:schema:v1:common#/$defs/timestamp" },
    "retired_at": { "$ref": "urn:conn:schema:v1:common#/$defs/timestamp" }
  }
}
