{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:conn:schema:v1:objective-import-input",
  "title": "Objective import input",
  "description": "Human-authored Conn Objective content and captured metadata for a local Kiro specification, a local Spec Kit feature, or a GitHub issue. Conn records the safe source reference, revision, and digest, never synchronizes the source automatically, and never receives a GitHub token.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "objective_id",
    "source_kind",
    "source_ref",
    "content_hash",
    "title",
    "overview_markdown",
    "accountable_human_id"
  ],
  "properties": {
    "objective_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
    "key": { "$ref": "urn:conn:schema:v1:common#/$defs/key" },
    "source_kind": { "$ref": "urn:conn:schema:v1:objective#/$defs/sourceKind" },
    "source_ref": { "$ref": "urn:conn:schema:v1:common#/$defs/relativePath" },
    "source_revision_ref": { "$ref": "urn:conn:schema:v1:common#/$defs/opaqueReference" },
    "content_hash": { "$ref": "urn:conn:schema:v1:common#/$defs/sha256" },
    "title": { "$ref": "urn:conn:schema:v1:common#/$defs/title" },
    "overview_markdown": { "$ref": "urn:conn:schema:v1:common#/$defs/markdown" },
    "accountable_human_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
    "key_points": {
      "type": "array",
      "maxItems": 50,
      "items": { "$ref": "urn:conn:schema:v1:objective#/$defs/keyPoint" }
    }
  }
}
