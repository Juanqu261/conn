{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:conn:schema:v1:blueprint-revision",
  "title": "BlueprintRevision",
  "description": "Immutable division of one exact Objective revision into complete CellCharter snapshots. Only status is a projection that changes after proposal. Objective references, unique keys, unique cells, and dependency targets are enforced by application validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "blueprint_id",
    "project_id",
    "revision",
    "objective_id",
    "objective_revision",
    "status",
    "proposed_by_human_id",
    "created_at",
    "cell_charters"
  ],
  "properties": {
    "blueprint_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
    "project_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
    "revision": { "$ref": "urn:conn:schema:v1:common#/$defs/revision" },
    "objective_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
    "objective_revision": { "$ref": "urn:conn:schema:v1:common#/$defs/revision" },
    "status": { "enum": ["proposed", "active", "rejected"] },
    "proposed_by_human_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
    "created_at": { "$ref": "urn:conn:schema:v1:common#/$defs/timestamp" },
    "cell_charters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/cellCharter" }
    }
  },
  "$defs": {
    "cellCharter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cell_id", "accountable_human_id", "title", "overview_markdown"],
      "properties": {
        "cell_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
        "accountable_human_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
        "title": { "$ref": "urn:conn:schema:v1:common#/$defs/title" },
        "overview_markdown": { "$ref": "urn:conn:schema:v1:common#/$defs/markdown" },
        "objective_point_refs": {
          "description": "Keys of points in the referenced Objective revision.",
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": { "$ref": "urn:conn:schema:v1:common#/$defs/key" }
        },
        "boundary_points": {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/boundaryPoint" }
        },
        "dependencies": {
          "type": "array",
          "maxItems": 31,
          "items": { "$ref": "#/$defs/dependency" }
        }
      }
    },
    "boundaryPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "kind", "statement"],
      "properties": {
        "key": { "$ref": "urn:conn:schema:v1:common#/$defs/key" },
        "kind": { "enum": ["responsibility", "exclusion", "deliverable", "evidence_obligation"] },
        "statement": { "$ref": "urn:conn:schema:v1:common#/$defs/statement" }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cell_id", "summary"],
      "properties": {
        "cell_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
        "summary": { "$ref": "urn:conn:schema:v1:common#/$defs/statement" }
      }
    }
  }
}
