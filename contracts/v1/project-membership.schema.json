{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:conn:schema:v1:project-membership",
  "title": "ProjectMembership",
  "description": "Grants one authenticated Conn human a role in one Project.",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id", "human_id", "role", "added_by_human_id", "added_at"],
  "properties": {
    "project_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
    "human_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
    "role": { "enum": ["owner", "member"] },
    "added_by_human_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
    "added_at": { "$ref": "urn:conn:schema:v1:common#/$defs/timestamp" }
  }
}
