{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:conn:schema:v1:common",
  "title": "Conn v1 shared definitions",
  "description": "Reusable value definitions referenced by Conn v1 protocol records. This document is not a record schema.",
  "$defs": {
    "uuidv7": {
      "description": "Canonical lowercase UUID version 7 with the RFC 9562 variant.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "description": "RFC 3339 timestamp in UTC with a Z offset and at most microsecond precision, matching PostgreSQL storage. Calendar validity is checked by the parser that consumes it.",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?Z$"
    },
    "revision": {
      "description": "Aggregate revision number. Revisions begin at 1.",
      "type": "integer",
      "minimum": 1
    },
    "eventSequence": {
      "description": "Project-scoped event cursor. The maximum is the largest integer represented exactly by JavaScript clients.",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "key": {
      "description": "Lowercase slug used for stable human-readable references within one record.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "noNul": {
      "description": "Text without U+0000, which PostgreSQL text cannot store. Every free-text definition includes it.",
      "type": "string",
      "pattern": "^[^\\x00]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "allOf": [{ "$ref": "#/$defs/noNul" }],
      "pattern": "[^\\t\\n\\v\\f\\r \u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]",
      "description": "Plain-text title containing at least one non-whitespace character."
    },
    "statement": {
      "description": "Concise plain-text statement.",
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "allOf": [{ "$ref": "#/$defs/noNul" }],
      "pattern": "[^\\t\\n\\v\\f\\r \u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]"
    },
    "markdown": {
      "description": "Untrusted Markdown. Renderers must sanitize it.",
      "type": "string",
      "minLength": 1,
      "maxLength": 32768,
      "allOf": [{ "$ref": "#/$defs/noNul" }],
      "pattern": "[^\\t\\n\\v\\f\\r \u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]"
    },
    "rationale": {
      "description": "Human-authored explanation for a decision.",
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "allOf": [{ "$ref": "#/$defs/noNul" }],
      "pattern": "[^\\t\\n\\v\\f\\r \u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]"
    },
    "httpUri": {
      "description": "Absolute http or https URI. Non-ASCII characters must be percent-encoded.",
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^https?://[!-~]+$"
    },
    "sha256": {
      "description": "Lowercase hexadecimal SHA-256 digest.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitCommit": {
      "description": "Lowercase abbreviated or full Git object ID. Repository-specific validation determines whether it exists.",
      "type": "string",
      "pattern": "^[0-9a-f]{7,64}$"
    },
    "repositoryRemote": {
      "description": "Normalized, credential-free Git host and path. It has no scheme, user information, port, query, or fragment.",
      "type": "string",
      "minLength": 3,
      "maxLength": 1024,
      "pattern": "^[a-z0-9][a-z0-9.-]*(/[A-Za-z0-9._~-]+)+$"
    },
    "relativePath": {
      "description": "Bounded non-empty path reference. Callers enforce repository-relative semantics and reject traversal.",
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "allOf": [{ "$ref": "#/$defs/noNul" }],
      "pattern": "[^\\r\\n]"
    },
    "opaqueReference": {
      "description": "A bounded non-secret correlation or external reference. It must not contain control characters.",
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "allOf": [{ "$ref": "#/$defs/noNul" }],
      "pattern": "[^\\t\\n\\v\\f\\r ]"
    },
    "semanticSubject": {
      "description": "A stable namespaced semantic-concept key. Its namespace and native references explain how it was derived.",
      "type": "string",
      "minLength": 3,
      "maxLength": 512,
      "pattern": "^[a-z][a-z0-9_-]*(?::[A-Za-z0-9._~/-]+)+$"
    },
    "semanticClaimKind": {
      "enum": [
        "behavior",
        "invariant",
        "contract",
        "data_resource",
        "infrastructure_resource",
        "code_symbol",
        "dependency",
        "assumption",
        "question",
        "acceptance_criterion"
      ]
    },
    "semanticRelation": {
      "enum": [
        "affects",
        "changes",
        "consumes",
        "produces",
        "depends_on",
        "removes",
        "verifies",
        "assumes",
        "questions"
      ]
    },
    "claimProvenance": {
      "enum": ["declared", "static_analysis", "external_import", "ci_evidence", "model_inference"]
    },
    "collisionSeverity": {
      "enum": ["info", "amber", "red"]
    },
    "resolutionKind": {
      "enum": [
        "dependency",
        "sequencing",
        "contract_agreement",
        "accepted_risk",
        "false_positive",
        "revise_objective",
        "revise_blueprint",
        "other"
      ]
    },
    "evidenceState": {
      "enum": ["passing", "failing", "missing", "stale", "inaccessible", "unknown"]
    },
    "semanticEventType": {
      "enum": [
        "repository.connected",
        "intent.published",
        "intent.revised",
        "intent.released",
        "claims.observed",
        "collision.opened",
        "collision.updated",
        "resolution.proposed",
        "resolution.decided",
        "evidence.attached",
        "objective.imported"
      ]
    }
  }
}
