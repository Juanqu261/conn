{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:conn:schema:v1:resolution-proposal-list",
  "title": "Resolution proposal list",
  "description": "The most recent non-binding proposals for one CollisionAssessment, oldest first. Listing a proposal never makes it a decision.",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id", "collision_id", "proposals"],
  "properties": {
    "project_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
    "collision_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
    "proposals": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "urn:conn:schema:v1:resolution-proposal" }
    },
    "authors": {
      "description": "The Participants that authored the listed proposals, so a reader can tell which proposals an agent wrote. Attribution only; it grants no authority.",
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["participant_id", "human_id", "adapter_kind"],
        "properties": {
          "participant_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
          "human_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
          "adapter_kind": {
            "enum": ["kiro", "mcp", "cli", "ci", "github", "other_registered_adapter"]
          }
        }
      }
    }
  }
}
