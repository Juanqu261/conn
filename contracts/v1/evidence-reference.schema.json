{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:conn:schema:v1:evidence-reference",
  "title": "EvidenceReference",
  "description": "Reference-first evidence linked to a project objective. Conn does not require the underlying artifact or raw output. Evidence without an observation is reported evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "project_id",
    "objective_id",
    "objective_revision",
    "kind",
    "state",
    "locator",
    "observed_at"
  ],
  "properties": {
    "evidence_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
    "project_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
    "intent_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
    "objective_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
    "objective_revision": { "$ref": "urn:conn:schema:v1:common#/$defs/revision" },
    "acceptance_key": { "$ref": "urn:conn:schema:v1:common#/$defs/key" },
    "kind": { "$ref": "urn:conn:schema:v1:common#/$defs/evidenceKind" },
    "state": { "$ref": "urn:conn:schema:v1:common#/$defs/evidenceState" },
    "locator": { "$ref": "urn:conn:schema:v1:common#/$defs/opaqueReference" },
    "content_hash": { "$ref": "urn:conn:schema:v1:common#/$defs/sha256" },
    "summary": { "$ref": "urn:conn:schema:v1:common#/$defs/statement" },
    "producer_participant_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
    "observation": { "$ref": "urn:conn:schema:v1:common#/$defs/evidenceObservation" },
    "observed_at": { "$ref": "urn:conn:schema:v1:common#/$defs/timestamp" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "kind": { "const": "check_run" } },
        "required": ["kind"]
      },
      "then": {
        "properties": { "observation": true },
        "required": ["observation"]
      },
      "else": {
        "not": {
          "properties": { "observation": true },
          "required": ["observation"]
        }
      }
    }
  ]
}
