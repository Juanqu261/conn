{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:conn:schema:v1:evidence-reference-list",
  "title": "Evidence reference list",
  "description": "The most recent evidence references attached to one Intent, newest first, visible to Project members.",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id", "intent_id", "evidence"],
  "properties": {
    "project_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
    "intent_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
    "evidence": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "urn:conn:schema:v1:evidence-reference" }
    }
  }
}
