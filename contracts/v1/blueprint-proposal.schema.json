{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:conn:schema:v1:blueprint-proposal",
  "title": "Blueprint proposal input",
  "description": "Human-authored content of one proposed BlueprintRevision. The Project comes from the request path; the server assigns the revision number, proposer, and creation time. Expected-revision checks belong to the request, not this document.",
  "type": "object",
  "additionalProperties": false,
  "required": ["blueprint_id", "objective_id", "objective_revision", "cell_charters"],
  "properties": {
    "blueprint_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
    "objective_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
    "objective_revision": { "$ref": "urn:conn:schema:v1:common#/$defs/revision" },
    "cell_charters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "urn:conn:schema:v1:blueprint-revision#/$defs/cellCharter" }
    }
  }
}
