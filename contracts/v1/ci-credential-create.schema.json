{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:conn:schema:v1:ci-credential-create",
  "title": "CI credential creation input",
  "description": "Owner-authored request for a CI credential bound to one RepositoryConnection of the Project. Conn generates the token.",
  "type": "object",
  "additionalProperties": false,
  "required": ["repository_id", "expires_in_days"],
  "properties": {
    "repository_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
    "label": { "$ref": "urn:conn:schema:v1:common#/$defs/title" },
    "expires_in_days": { "type": "integer", "minimum": 1, "maximum": 365 }
  }
}
