{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:conn:schema:v1:ci-credential",
  "title": "CI credential",
  "description": "A narrow credential that lets the Conn pull-request check read one Project and preview collisions for one RepositoryConnection. It never carries its token: Conn stores only the token's SHA-256 hash.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "credential_id",
    "project_id",
    "repository_id",
    "created_by_human_id",
    "created_at",
    "expires_at"
  ],
  "properties": {
    "credential_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
    "project_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
    "repository_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
    "label": { "$ref": "urn:conn:schema:v1:common#/$defs/title" },
    "created_by_human_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
    "created_at": { "$ref": "urn:conn:schema:v1:common#/$defs/timestamp" },
    "expires_at": { "$ref": "urn:conn:schema:v1:common#/$defs/timestamp" },
    "last_used_at": { "$ref": "urn:conn:schema:v1:common#/$defs/timestamp" },
    "revoked_at": { "$ref": "urn:conn:schema:v1:common#/$defs/timestamp" }
  }
}
