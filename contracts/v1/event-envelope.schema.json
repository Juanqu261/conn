{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:conn:schema:v1:event-envelope",
  "title": "EventEnvelope",
  "description": "Append-only record of one committed authoritative mutation within a Project. Each event type fixes its entity type and payload shape. Payloads carry only identity, revision, and cell references, never secrets or raw external data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "event_sequence",
    "event_id",
    "event_type",
    "entity_type",
    "entity_id",
    "actor_human_id",
    "occurred_at",
    "payload"
  ],
  "properties": {
    "project_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
    "event_sequence": { "$ref": "urn:conn:schema:v1:common#/$defs/eventSequence" },
    "event_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
    "event_type": {
      "enum": [
        "project.created",
        "project.member_added",
        "objective.revision_created",
        "blueprint.revision_proposed",
        "blueprint.revision_activated",
        "blueprint.revision_rejected",
        "charter.accepted",
        "charter.rejected",
        "repository.connected",
        "intent.published",
        "intent.revised",
        "intent.released",
        "claims.observed",
        "collision.opened",
        "collision.updated",
        "resolution.proposed",
        "resolution.decided",
        "evidence.attached",
        "objective.imported"
      ]
    },
    "entity_type": {
      "description": "Membership events use entity type project with the member identity in the payload.",
      "enum": [
        "project",
        "objective",
        "blueprint",
        "charter_decision",
        "repository",
        "intent",
        "semantic_claim",
        "collision",
        "resolution_proposal",
        "resolution_decision",
        "evidence_reference"
      ]
    },
    "entity_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
    "actor_human_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
    "occurred_at": { "$ref": "urn:conn:schema:v1:common#/$defs/timestamp" },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "event_type": { "const": "project.created" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "entity_type": { "const": "project" },
          "payload": { "$ref": "#/$defs/emptyPayload" }
        }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "project.member_added" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "entity_type": { "const": "project" },
          "payload": { "$ref": "#/$defs/memberAddedPayload" }
        }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "objective.revision_created" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "entity_type": { "const": "objective" },
          "payload": { "$ref": "#/$defs/revisionPayload" }
        }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "blueprint.revision_proposed" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "entity_type": { "const": "blueprint" },
          "payload": { "$ref": "#/$defs/blueprintProposedPayload" }
        }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "blueprint.revision_activated" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "entity_type": { "const": "blueprint" },
          "payload": { "$ref": "#/$defs/revisionPayload" }
        }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "blueprint.revision_rejected" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "entity_type": { "const": "blueprint" },
          "payload": { "$ref": "#/$defs/blueprintRejectedPayload" }
        }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "enum": ["charter.accepted", "charter.rejected"] } },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "entity_type": { "const": "charter_decision" },
          "payload": { "$ref": "#/$defs/charterDecisionPayload" }
        }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "repository.connected" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "entity_type": { "const": "repository" },
          "payload": { "$ref": "#/$defs/emptyPayload" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": { "enum": ["intent.published", "intent.revised", "intent.released"] }
        },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "entity_type": { "const": "intent" },
          "payload": { "$ref": "#/$defs/revisionPayload" }
        }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "claims.observed" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "entity_type": { "const": "semantic_claim" },
          "payload": { "$ref": "#/$defs/claimObservedPayload" }
        }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "enum": ["collision.opened", "collision.updated"] } },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "entity_type": { "const": "collision" },
          "payload": { "$ref": "#/$defs/emptyPayload" }
        }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "resolution.proposed" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "entity_type": { "const": "resolution_proposal" },
          "payload": { "$ref": "#/$defs/emptyPayload" }
        }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "resolution.decided" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "entity_type": { "const": "resolution_decision" },
          "payload": { "$ref": "#/$defs/emptyPayload" }
        }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "evidence.attached" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "entity_type": { "const": "evidence_reference" },
          "payload": { "$ref": "#/$defs/emptyPayload" }
        }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "objective.imported" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "entity_type": { "const": "objective" },
          "payload": { "$ref": "#/$defs/revisionPayload" }
        }
      }
    }
  ],
  "$defs": {
    "emptyPayload": {
      "type": "object",
      "additionalProperties": false
    },
    "memberAddedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["human_id", "role"],
      "properties": {
        "human_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
        "role": { "enum": ["owner", "member"] }
      }
    },
    "revisionPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision"],
      "properties": {
        "revision": { "$ref": "urn:conn:schema:v1:common#/$defs/revision" }
      }
    },
    "claimObservedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent_id", "intent_revision"],
      "properties": {
        "intent_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
        "intent_revision": { "$ref": "urn:conn:schema:v1:common#/$defs/revision" }
      }
    },
    "blueprintProposedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "objective_id", "objective_revision"],
      "properties": {
        "revision": { "$ref": "urn:conn:schema:v1:common#/$defs/revision" },
        "objective_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
        "objective_revision": { "$ref": "urn:conn:schema:v1:common#/$defs/revision" }
      }
    },
    "blueprintRejectedPayload": {
      "description": "Names the cell whose charter rejection made the revision inactive.",
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "cell_id"],
      "properties": {
        "revision": { "$ref": "urn:conn:schema:v1:common#/$defs/revision" },
        "cell_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" }
      }
    },
    "charterDecisionPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blueprint_id", "blueprint_revision", "cell_id"],
      "properties": {
        "blueprint_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" },
        "blueprint_revision": { "$ref": "urn:conn:schema:v1:common#/$defs/revision" },
        "cell_id": { "$ref": "urn:conn:schema:v1:common#/$defs/uuidv7" }
      }
    }
  }
}
