# Generated by conn ci install (template v1). Conn source @@CONN_REF@@.
# Conn reports findings and never fails this check for them. It writes nothing
# to Conn and runs no code from the pull request.
name: Conn check

on:
  pull_request:
    types: [opened, synchronize, reopened, ready_for_review]

permissions:
  contents: read
@@PR_WRITE_PERMISSION@@

concurrency:
  group: conn-check-${{ github.event.pull_request.number }}
  cancel-in-progress: true

jobs:
  conn-check:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - name: Check out pull request
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: ${{ github.event.pull_request.head.sha }}
          fetch-depth: 0
          path: repo
          persist-credentials: false

      # Distribution: build Conn from its pinned source (decision 0008). This
      # step and the next three can be replaced by another distribution method.
      - name: Check out Conn
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          repository: Juanqu261/conn
          ref: @@CONN_REF@@
          path: conn
          persist-credentials: false

      - uses: pnpm/action-setup@73e46992e05b19abd31f2f3c20e0e7370d762115 # v6.1.1
        with:
          version: 12.21.0
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version-file: conn/.node-version
          cache: pnpm
          cache-dependency-path: conn/pnpm-lock.yaml
      - uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0
        with:
          go-version: 1.27.4
          cache-dependency-path: conn/go.sum

      - name: Build Conn
        working-directory: conn
        run: |
          pnpm install --frozen-lockfile
          pnpm --filter @conn/typescript-analyzer run build
          go build -o "$RUNNER_TEMP/conn" ./cmd/conn

      - name: Conn check
        env:
          CONN_SERVER_URL: ${{ vars.CONN_SERVER_URL }}
          CONN_CI_TOKEN: ${{ secrets.CONN_CI_TOKEN }}
          CONN_ANALYZER_PATH: ${{ github.workspace }}/conn/packages/typescript-analyzer/dist/cli.js
@@COMMENT_ENV@@
        run: '"$RUNNER_TEMP/conn" ci check --worktree repo@@COMMENT_FLAG@@'
